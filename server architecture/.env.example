# ============================================================
# Re-Tech Fusion Phase 2 — environment configuration
# Copy this file to .env and adjust as needed.
# .env is gitignored.
# ============================================================

# ---- Postgres / TimescaleDB ----
POSTGRES_USER=retech
POSTGRES_PASSWORD=retech
POSTGRES_DB=retech
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# If you already have a Postgres service installed on the host (Windows users:
# check `tasklist /FI "imagename eq postgres.exe"`), bump this to 55432 to avoid
# the host-side port collision.

# ---- Redis (RQ queue) ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Mosquitto MQTT broker (deployed; ingestion stubbed until Phase 1 is online) ----
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883
MQTT_TOPIC_READINGS=retech/devices/+/readings

# ---- Invoice extraction ----
# Tiered extraction strategy. Allowed values:
#   qwen_then_regex  — try Ollama Qwen first, fall back to Tesseract+regex on failure / low confidence (DEFAULT)
#   qwen_only        — Ollama Qwen only; fail if it can't deliver
#   regex_only       — Tesseract+regex only (fastest, no model required)
#   regex_then_qwen  — Tesseract+regex first; escalate to Qwen on low confidence
EXTRACTION_STRATEGY=qwen_then_regex

# Ollama vision-language model (local). Pull with: ollama pull qwen2.5vl:3b
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:3b

# Confidence threshold below which an extractor is considered insufficient
# and the orchestrator falls back to the next tier (0..1).
MIN_CONFIDENCE=0.8

# ---- Filesystem paths (relative to project root) ----
INBOX_XLSX_PATH=inbox/xlsx
INBOX_PDF_PATH=inbox/pdf
OCR_CACHE_PATH=data/ocr_cache

# ---- OCR toolchain ----
# Leave blank to use whatever is on PATH. Set to absolute paths for installs
# that aren't on PATH (typical for Tesseract / Poppler on Windows).
# Example Windows values:
#   TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
#   POPPLER_PATH=C:\poppler\Library\bin
TESSERACT_CMD=
POPPLER_PATH=
PDF_RENDER_DPI=300

# ---- Logging ----
LOG_LEVEL=INFO
# console | json
LOG_FORMAT=console

# ---- API ----
API_HOST=0.0.0.0
API_PORT=8000
